# =============================================================================
# IIOS — .env.example
# Environment variable template. Copy to .env.development and fill in values.
# This file is COMMITTED to git (no real secrets here).
# =============================================================================

# ── Runtime Environment ───────────────────────────────────────────────────────
# Options: development | testing | production
IIOS_ENV=development

# CRITICAL: Keep true until SYSTEM_CERTIFIED (WinRate>=50%, Sharpe>0.8, MaxDD<15%)
IIOS_PAPER_TRADING=true

# Log level: DEBUG | INFO | WARNING | ERROR
IIOS_LOG_LEVEL=INFO
IIOS_LOG_FILE=logs/iios.log

# ── Database ──────────────────────────────────────────────────────────────────
# Use :memory: for testing, absolute path for production
IIOS_DB_PATH=data/iios.db
IIOS_PAPER_TRADES_PATH=data/paper_trades.csv

# ── Dhan API ──────────────────────────────────────────────────────────────────
# Token expires daily — see DHAN_DAILY_TOKEN_REQUIREMENT.md
# Obtain from: https://dhanhq.co/ → API section
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ── Broker credential store (dashboard Settings page) ─────────────────────────
# Encrypts credentials saved on the Settings page (data/broker/credentials.enc).
# Keep it only in the server .env — NOT next to the encrypted file. Generate with:
#   python -m broker_auth.credentials --generate-key
# Losing or changing it makes saved credentials unreadable (re-enter them).
CREDENTIALS_KEY=

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# From developers.kite.trade → your app. Keep the secret on the server only.
# In the Kite app settings set the Redirect URL to:  https://<dashboard-domain>/kite/callback
# Daily login: dashboard → "Connect Zerodha" (token saved to data/broker/, git-ignored).
KITE_API_KEY=
KITE_API_SECRET=
# Optional: where the daily session token is stored (default: data/broker)
# KITE_SESSION_DIR=
# Public dashboard URL, used in the Telegram morning login reminder
DASHBOARD_PUBLIC_URL=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Create bot via: https://t.me/BotFather
# Get chat ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
# TELEGRAM_CHAT_ID may be a private chat or a group (group ids are negative, e.g. -100...).
# Comma-separated Telegram USER ids allowed to run control commands
# (/pause, /resume, /token, /rescan). Required when the chat is a group,
# otherwise nobody in the group can run them. Get your id from @userinfobot.
TELEGRAM_WHITELIST_IDS=123456789

# ── Web Dashboard (web_dashboard/) ────────────────────────────────────────────
DASHBOARD_PORT=8501
# Password hash only — never the password. Set with: python -m web_dashboard.set_password
DASHBOARD_PASSWORD_HASH=
# Hours a login stays valid
DASHBOARD_SESSION_HOURS=12
# Set true once the dashboard is served over HTTPS
DASHBOARD_COOKIE_SECURE=false
# Reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted (for per-visitor login lockout).
# Leave empty when the dashboard is reached directly.
DASHBOARD_TRUSTED_PROXIES=

# ── Risk Parameters (leave blank to use config.py defaults) ───────────────────
# Changing these requires Architecture Council approval (FC-RULE-017).
# IIOS_DECISION_THRESHOLD=6.5
# IIOS_VIX_THRESHOLD=45.0
# IIOS_DAILY_LOSS_PCT=0.02

# ── Broker Routing ────────────────────────────────────────────────────────────
BROKER_PRIMARY=dhan
BROKER_FALLBACK=yahoo

# ── Feature Flags ─────────────────────────────────────────────────────────────
IIOS_ENABLE_TELEGRAM=false
IIOS_ENABLE_DASHBOARD=true
IIOS_CONTINUOUS_SCAN=false
IIOS_ENABLE_LIVE_TRADING=false